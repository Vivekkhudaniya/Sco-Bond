# RPC endpoint (default: local Anvil node)
RPC_URL=http://127.0.0.1:8545

# Platform Admin — deploys all contracts, creates deals
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Registrar — whitelists investor wallets (optional, defaults to deployer)
REGISTRAR_PRIVATE_KEY=

# B&D Agent — mints bonds, initiates DVD transfers (optional, defaults to deployer)
BND_AGENT_PRIVATE_KEY=

# Investor wallets (optional — script generates random wallets if not set)
INVESTOR1_PRIVATE_KEY=
INVESTOR2_PRIVATE_KEY=

# Deal parameters (optional — defaults shown)
TOKEN_NAME=SCO Bond 51X5RT
TOKEN_SYMBOL=SCO51X
