# ── Network ──
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# ── Deployer (Platform Admin) ──
DEPLOYER_PRIVATE_KEY=0x_your_private_key_here

# ── Role addresses (can all be the deployer for testnet) ──
PLATFORM_ADMIN=0x_your_deployer_address
REGISTRAR_SAFE=0x_your_deployer_address
BND_SAFE=0x_your_deployer_address

# ── Investor addresses (for testnet, can be any wallets you control) ──
INVESTOR_AURORA=0x_investor_1
INVESTOR_NORTHBRIDGE=0x_investor_2
INVESTOR_MERIDIAN=0x_investor_3

# ── Deployed addresses (filled in after DeployPlatform) ──
IA=
FACTORY=
GATEWAY=
SUPPLY_LIMIT_MODULE=
MOCK_CASH_TOKEN=
DVD_MANAGER=

# ── Deal addresses (filled in after DeployDeal tx logs) ──
TOKEN_PROXY=
IR_PROXY=

# ── Deal parameters ──
SUPPLY_LIMIT=5000
TOKEN_NAME=ACME Corp / 3.875% Fixed EMTN
TOKEN_SYMBOL=TR-51X5RT-01

# ── Verification (optional) ──
POLYGONSCAN_API_KEY=
